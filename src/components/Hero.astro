---
import Logo from './Logo.astro';
---
<section class="hero" id="inicio">
  <div class="floor" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <div class="hero-copy">
      <Logo class="logo" label="Logo de Black Flower" />
      <p class="eyebrow">Club privado · Solo parejas</p>
      <h1><span>BLACK</span><span>FLOWER</span></h1>
      <p class="lead">Un espacio exclusivo para parejas que buscan nuevas experiencias</p>
      <div class="ctas">
        <a class="btn" href="#eventos">Ver próximos eventos</a>
        <a class="btn alt" href="https://wa.me/59100000000?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n" target="_blank" rel="noopener" data-wa>Contactar por WhatsApp</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1400&q=85" alt="Luces y ambiente de un club nocturno" fetchpriority="high" />
      <span class="hero-caption">Una noche diferente</span>
    </div>
  </div>
  <a class="scroll-hint" href="#eventos" aria-label="Bajar a eventos"></a>
</section>
