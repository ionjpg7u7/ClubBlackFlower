<section id="contacto">
  <div class="wrap">
    <h2 class="reveal">Contacto</h2>
    <div class="contact-grid">
      <form id="form" class="reveal" novalidate>
        <div><label for="nombre">Nombre</label><input id="nombre" name="nombre" autocomplete="name" required /></div>
        <div><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div><label for="mensaje">Mensaje</label><textarea id="mensaje" name="mensaje" required></textarea></div>
        <button class="btn solid" type="submit">Enviar</button>
        <p class="form-msg" id="form-msg" role="status"></p>
      </form>
      <div class="direct reveal">
        <p>¿Prefieres hablar directamente? Escríbenos o llámanos.</p>
        <a class="btn" href="https://wa.me/59100000000" target="_blank" rel="noopener" data-wa>WhatsApp</a>
        <a class="btn" href="tel:+59100000000">Teléfono</a>
      </div>
    </div>
  </div>
</section>
