---
import '../styles/global.css';
import '../styles/neon.css';
const { title = 'Black Flower · Club privado' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es" data-theme="azul">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon_black.svg?v=3`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=3`} media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700&family=Nunito:wght@400;500;600;700&family=Tilt+Neon&display=swap" rel="stylesheet" />
  </head>
  <body class="locked">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="flor" viewBox="0 0 100 100">
        <path pathLength="1" d="M50 50 C38 36 38 16 50 6 C62 16 62 36 50 50Z" />
        <path pathLength="1" d="M50 50 C38 36 38 16 50 6 C62 16 62 36 50 50Z" transform="rotate(72 50 50)" />
        <path pathLength="1" d="M50 50 C38 36 38 16 50 6 C62 16 62 36 50 50Z" transform="rotate(144 50 50)" />
        <path pathLength="1" d="M50 50 C38 36 38 16 50 6 C62 16 62 36 50 50Z" transform="rotate(216 50 50)" />
        <path pathLength="1" d="M50 50 C38 36 38 16 50 6 C62 16 62 36 50 50Z" transform="rotate(288 50 50)" />
        <circle pathLength="1" cx="50" cy="50" r="4" />
      </symbol>
    </svg>
    <slot />
    <script>import '../scripts/main.js';</script>
  </body>
</html>
